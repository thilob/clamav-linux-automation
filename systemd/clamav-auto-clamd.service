[Unit]
Description=ClamAV daemon for automation
After=local-fs.target network.target
RequiresMountsFor=/var/lib/clamav-automation/database

[Service]
Type=simple
RuntimeDirectory=clamav-automation
RuntimeDirectoryMode=0770
User=clamav-auto
Group=clamav-auto
ExecStart=/usr/bin/clamd --foreground=yes --config-file=/etc/clamav-automation/clamd.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
