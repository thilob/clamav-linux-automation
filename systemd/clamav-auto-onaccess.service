[Unit]
Description=ClamAV On-Access scanner (clamonacc)
Requires=clamav-auto-clamd.service
After=clamav-auto-clamd.service

[Service]
Type=simple
TimeoutStartSec=210
ExecStartPre=/usr/local/libexec/clamav-automation/clamav-wait-for-clamd.sh 180
ExecStart=/usr/bin/clamonacc --foreground --fdpass --config-file=/etc/clamav-automation/clamd.conf
Restart=on-failure
RestartSec=10s

# clamonacc benötigt für fanotify erhöhte Rechte.
User=root
Group=root

[Install]
WantedBy=multi-user.target
